{
  "name": "vcon-google-meet-adapter",
  "version": "0.1.0",
  "description": "Turn Google Meet conference records and transcripts into vCons",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "vcon-google-meet": "dist/cli.js"
  },
  "scripts": {
