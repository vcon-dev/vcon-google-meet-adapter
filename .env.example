# Google OAuth client (Web application). The redirect URI must be registered on the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback

# Lawful basis stamped on every vCon. One of: consent, contract, legal_obligation,
# vital_interests, public_task, legitimate_interests. Leave blank to emit vCons without one.
LAWFUL_BASIS=
# Required for every basis except legitimate_interests
LAWFUL_BASIS_EXPIRATION=
# Comma list of granted purposes
LAWFUL_BASIS_PURPOSES=recording,transcription
LAWFUL_BASIS_CONTROLLER=
LAWFUL_BASIS_STATEMENT=
LAWFUL_BASIS_TOS_URL=

# Optional conserver delivery (sync --post)
CONSERVER_URL=
CONSERVER_API_TOKEN=
CONSERVER_HEADER_NAME=x-conserver-api-token
CONSERVER_INGRESS_LIST=default
